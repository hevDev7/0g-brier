# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which is the point of having one. Next's generated
# .gitignore excludes every `.env*`, and the root repo already tracks its own
# `.env.example` — so this one was silently absent while the README told readers
# to copy it. A template holds no secrets; the file it is copied to does.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
