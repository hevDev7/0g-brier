# Where the pages read from. Every mode is honest about what it cannot answer —
# a mode that has no trade history says so rather than drawing an empty chart.
#
#   mock      fixtures only. No chain, no network, nothing to configure.
#   chain     live contract state. No trade history, so volume and Δ24h report
#             themselves unavailable rather than as zero.
#   indexer   chain state plus history rebuilt from logs. What this file sets up.
NEXT_PUBLIC_DATA_MODE=indexer

# 0G Galileo testnet.
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_CHAIN_ID=16602

# The factory is the entry point: every market is found through it, and the
# frontend reads nothing it did not mint.
NEXT_PUBLIC_MARKET_FACTORY=0xd6F9aE316ef729C6c79fbC8684a2b0e4B76D4133

# The lower bound for every getLogs range, from deployments/16602.json. Never
# scans below it, which is what keeps the range bounded and the scan honest.
# A missing bound scans wider than necessary; a WRONG one silently drops the
# events beneath it and shows a market as having no history at all.
NEXT_PUBLIC_FROM_BLOCK=51923879

# 0G Storage. Optional and separate from the EVM RPC: without it `question` and
# `rules` stay null and MARKET_SPEC_BLOB is reported unavailable, which is true.
# With it, the document behind `specRoot` is fetched AND verified — the bytes
# must hash back to the root the chain holds, or nothing is rendered.
NEXT_PUBLIC_ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Hostnames allowed to reach the dev server through a tunnel, comma separated.
# Only the hostname, no scheme. Leave empty for plain localhost.
DEV_ALLOWED_HOSTS=
