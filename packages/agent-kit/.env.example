# An agent's configuration. Copy to .env beside your agent and chmod 600 it:
# the first line is a private key, and the rest are addresses and endpoints
# that are safe to share.
#
#   cp ../brier/packages/agent-kit/.env.example .env
#   chmod 600 .env

# ── the only secret ──────────────────────────────────────────────────────────
# A wallet of its own. This is a program that trades on a loop, which is the
# wrong place for a key holding anything you would mind losing.
AGENT_KEY=

# ── where the chain is ───────────────────────────────────────────────────────
CHAIN_ID=16661
RPC_URL=https://evmrpc.0g.ai
# The protocol repo's deployments/, holding the contract addresses. Not shipped
# inside the npm package: an address baked into a version would go on being
# served long after a redeployment moved it.
DEPLOYMENTS_DIR=../brier/deployments
# 0G Storage gateway. Without it an agent cannot read the question it is trading.
# 0G Storage has two networks and they share no data. Mainnet (16661) is
# https://indexer-storage-turbo.0g.ai; Galileo (16602) is
# https://indexer-storage-testnet-turbo.0g.ai. Their Flow contracts have no
# code on each other's chain, so a mismatch reverts at gas estimation — and
# the half that succeeds is worse, because a specRoot is immutable at birth.
# Leave this unset and it is derived from CHAIN_ID.
# ZG_INDEXER=https://indexer-storage-turbo.0g.ai
# Permissionless, and refused only if taken.
AGENT_NAME=

# ── how much it is willing to risk ───────────────────────────────────────────
# Each of these is a refusal, not a target: a condition under which the agent
# declines to act. Defaults are the reference agent's own.

# Never stake more than this share of the bankroll, whatever Kelly says. A
# FRACTION, not basis points — the one setting here that is not in bps.
BANKROLL_FRACTION_CAP=0.25
# Never move the implied probability more than 5 points with one order. The cap
# that matters on a DPM: the order walks the price it is paying.
MAX_IMPACT_BPS=500
# How far above the quote a fill may land. Somebody else's order can arrive
# between the quote and the send.
SLIPPAGE_BPS=100
# Below 2 points of edge the fee eats it, so the trade is a loss in disguise.
MIN_EDGE_BPS=200
# 6 points of edge AGAINST an open position closes it. Holding is not free here.
REVERSAL_EDGE_BPS=600

# ── only if the agent forms its beliefs with a hosted model ──────────────────
# Nothing in the SDK requires either. 0G Compute is reached through the SDK's
# own ZgInference and needs no key here.
ANTHROPIC_API_KEY=
ZG_PROVIDER=
