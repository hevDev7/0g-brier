{
  "name": "@0g-brier/protocol",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/deployments.node.d.ts",
      "import": "./dist/deployments.node.js",
      "default": "./dist/deployments.node.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "gen:vectors": "tsx scripts/gen-vectors.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "description": "The Dynamic Pari-mutuel Market maths behind Brier, in TypeScript \u2014 pricing, quoting, units and deployment manifests.",
  "keywords": [
    "prediction-market",
    "dpm",
    "parimutuel",
    "0g",
    "defi"
  ],
  "license": "MIT",
  "author": "0g-brier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hevDev7/0g-brier.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/hevDev7/0g-brier#readme",
  "bugs": {
    "url": "https://github.com/hevDev7/0g-brier/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts"
}
