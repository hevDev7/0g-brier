# Copy to `.env` in this same directory, fill it in, then `chmod 600 .env`.
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored and is read automatically by scripts/deploy-galileo.sh and
# scripts/e2e-market.sh. Keeping the key here rather than on a command line is the
# point: a `export DEPLOYER_KEY=0x...` typed at a prompt lands in shell history,
# and in an agent-driven session it lands in the transcript too.

# ── required to deploy (scripts/deploy-galileo.sh) ───────────────────────────

# The account that sends the deployment. Needs about 0.1 0G on Galileo at current
# gas prices; the faucet at https://faucet.0g.ai gives 0.1 0G per wallet per day.
# It also becomes the ConfigRegistry owner and guardian.
# The `0x` prefix is optional here — the scripts add it if it is missing.
DEPLOYER_KEY=

# Where protocol fees go. May be the deployer on a testnet — the script asks for
# confirmation rather than assuming, because on any chain that is not anvil this
# is one of the two addresses a deployment most needs to be deliberate about.
TREASURY=0x

# The only key that can approve a market for creation (EIP-712). In P2 this
# becomes an AgentRegistry lookup; until then it is a single address.
CURATOR_SIGNER=0x

# Optional. Defaults to https://evmrpc-testnet.0g.ai (chain 16602).
# ZERO_G_TESTNET_RPC=https://evmrpc-testnet.0g.ai

# ── required to run the live lifecycle (scripts/e2e-market.sh) ───────────────

# The private key BEHIND CURATOR_SIGNER above — the script has to sign an approval
# with it. If CURATOR_SIGNER is the deployer's own address, leave this unset and
# it falls back to DEPLOYER_KEY.
# CURATOR_KEY=0x

# Seconds of trading before the market can be closed. On a public chain the script
# genuinely waits this long, twice (trading, then settlement), so keep it small.
# TRADING_WINDOW_SECONDS=180

# ── 0G Storage (scripts/upload-spec.mjs) ─────────────────────────────────────

# Where the MarketSpec document is stored. A market's `specRoot` is that
# document's Merkle root, so without an upload the root addresses nothing and the
# market has no readable question — which is what the first live market on
# Galileo shipped as.
#
# Optional; this is the default. Uploading pays gas on 0G Chain with DEPLOYER_KEY,
# so a local anvil run skips it and says so rather than inventing a root.
# ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Force an upload on a chain that is not Galileo. Off by default.
# ZG_UPLOAD=1

# ── pointing the web UI at a deployment (frontend/.env.local) ────────────────
#
# These are NEXT_PUBLIC_*, read by the browser bundle, so they live in
# `frontend/.env.local` rather than here — and that file is gitignored by
# `frontend/.gitignore` (`.env*`), which is why this block is a comment and not a
# template. Copy it across, then restart the dev server; Next reads env at boot.
#
#   NEXT_PUBLIC_DATA_MODE=chain
#   NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
#   NEXT_PUBLIC_CHAIN_ID=16602
#   NEXT_PUBLIC_MARKET_FACTORY=<the MarketFactory from deployments/16602.json>
#   NEXT_PUBLIC_ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
#
# The last one is optional and separate from the RPC: 0G Storage is a different
# network. Without it questions and settlement rules read as unavailable, which
# is true rather than merely missing. With it, the page fetches the document
# behind `specRoot` AND verifies it — the bytes must hash back to the root the
# chain holds, so a wrong document is an error rather than a heading.
#
# Omit the file entirely for `mock`, which is the default and needs nothing.
