{
  "name": "brier",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native binary prediction market on 0G Chain \u2014 DPM pricing, a TEE-backed resolver committee.",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:vectors": "npm run gen:vectors -w @brier/protocol"
  },
  "devDependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.11",
    "ethers": "^6.13.1",
    "@0gfoundation/0g-compute-ts-sdk": "^0.9.0"
  }
}
