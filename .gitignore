node_modules/
.env
.env.local
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/
.next/
*.log
coverage/
lcov.info

# Next 16.3.3 regenerates these on every `next dev` run
# (next/dist/server/lib/generate-agent-files.js) — ignore rather than
# fight the tool.
frontend/AGENTS.md
frontend/CLAUDE.md

# Manifest safety copies made by scripts/deploy-galileo.sh before each run.
# They exist so a failed broadcast cannot leave the repo pointing at addresses
# that were only ever simulated; they are not history worth keeping.
deployments/*.json.bak-*
deployments/*.json.pre-clean-*
