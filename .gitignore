node_modules/
.env
.env.local
# Every .env variant, not just the two that existed when this line was written.
# `.env.mainnet` holds a key that signs on a chain with real money on it, and a
# gitignore that lists files by name rather than by shape is one `git add -A`
# away from publishing it.
.env.*
!.env.example
!.env*.example
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/
.next/
*.log
coverage/
lcov.info

# Next 16.3.3 regenerates these on every `next dev` run
# (next/dist/server/lib/generate-agent-files.js) — ignore rather than
# fight the tool.
frontend/AGENTS.md
frontend/CLAUDE.md

# Manifest safety copies made by scripts/deploy-galileo.sh before each run.
# They exist so a failed broadcast cannot leave the repo pointing at addresses
# that were only ever simulated; they are not history worth keeping.
deployments/*.json.bak-*
deployments/*.json.pre-clean-*

# A parallel session works here. Not this repo's to commit.
Frontend-New/

# Build output. Regenerated by `npm install` (each package's `prepare`) and by
# `npm publish`; committing it would let a stale artifact outlive its source.
packages/*/dist/

# Submission material — kept locally, never shipped. The competition text, its
# video script and the recording are working documents about the repo rather than
# part of it, and a judge reading the repo should meet the README, not the pitch.
docs/akindo-submission.md
docs/demo-video-script.md
docs/brier-demo-silent.mp4

# Python bytecode from scripts/test_market_spec.py, which runs out of scripts/.
__pycache__/
*.pyc
